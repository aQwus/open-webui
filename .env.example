# Ollama URL for the backend to connect
# The path '/ollama' will be redirected to the specified backend URL
OLLAMA_BASE_URL='http://localhost:11434'

OPENAI_API_BASE_URL=''
OPENAI_API_KEY=''

WEBUI_SECRET_KEY = ''

# Gemini
GEMINI_API_KEY = ''

MODEL1 = 'gemini-2.5-flash'
MODEL2 = 'gemini-2.5-flash-lite'
MODEL3 = 'gemini-2.0-flash'

TOP_K = 5

# Supabase
SUPABASE_URL = ''
SUPABASE_SERVICE_ROLE_KEY = ''

# Cloudflare
R2_ENDPOINT = ''
R2_ACCESS_KEY_ID = ''
R2_SECRET_ACCESS_KEY = ''
R2_BUCKET = ''
R2_REGION = ''

# Composio
COMPOSIO_API_KEY = ''
ATTIO_AUTH_CONFIG_ID = ''
ATTIO_RECORDS_LIST_LIMIT = 100
ATTIO_RECORDS_NOTES_LIMIT = 50
NOTION_AUTH_CONFIG_ID = ''
NOTION_LIST_LIMIT = 10
GDOCS_AUTH_CONFIG_ID = ''
GDOCS_SEARCH_MAX_RESULTS = 100

# AUTOMATIC1111_BASE_URL="http://localhost:7860"

# For production, you should only need one host as
# fastapi serves the svelte-kit built frontend and backend from the same host and port.
# To test with CORS locally, you can set something like
# CORS_ALLOW_ORIGIN='http://localhost:5173;http://localhost:8080'
CORS_ALLOW_ORIGIN='*'

# For production you should set this to match the proxy configuration (127.0.0.1)
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false